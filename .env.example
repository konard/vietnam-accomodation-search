# Required for bot or combined mode. Set either the value or its *_FILE variant.
# Keep real values only in an untracked .env or a mounted secret file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_EXPECTED_BOT_ID=

# Required together for MTProto user or combined mode. Session material must be
# explicitly injected; it is never written to LiNo storage or an image layer.
TELEGRAM_API_ID=
TELEGRAM_API_ID_FILE=
TELEGRAM_API_HASH=
TELEGRAM_API_HASH_FILE=
TELEGRAM_USER_SESSION=
TELEGRAM_USER_SESSION_FILE=
TELEGRAM_USER_SESSION_FORMAT=mtcute/session-string-v1
TELEGRAM_EXPECTED_USER_ID=

# Private mode fails closed. Only numeric IDs are accepted; usernames are ignored.
TELEGRAM_ACCESS_MODE=private
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

HEALTH_PORT=8080

# Host-side durable root mounted at /data. Keep Telegram secrets outside it.
DATA_DIRECTORY_HOST=.vietnam-accomodation-search

# Conservative browser pacing. Challenges persist a bounded per-domain cooldown.
BROWSER_MIN_INTERVAL_MS=3000
BROWSER_MAX_INTERVAL_MS=8000
BROWSER_MAX_COOLDOWN_MS=3600000

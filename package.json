{
  "name": "vietnam-accomodation-search",
  "version": "0.11.30",
  "description": "Browser-driven Vietnam accommodation search with a Telegram bot",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "vietnam-accomodation-search": "./bin/vietnam-accomodation-search.js"
  },
  "files": [
    "bin/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "test": "node --test --test-timeout=30000 tests/*.test.js",
    "test:coverage": "node --test --test-concurrency=1 --test-timeout=30000 --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-lines=100 tests/*.test.js",
    "lint": "node scripts/lint.mjs",
    "lint:all": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplication": "jscpd .",
    "check": "npm run lint && npm run format:check && npm run check:duplication",
    "example:web:dev": "npm --prefix examples/universal-app run dev",
    "example:web:build": "npm --prefix examples/universal-app run build",
    "example:web:preview": "npm --prefix examples/universal-app run preview",
    "example:web:preview-images": "node scripts/update-preview-images.mjs",
    "example:desktop:package": "npm --prefix examples/universal-app run desktop:package",
    "example:desktop:make": "npm --prefix examples/universal-app run desktop:make",
    "example:mobile:sync": "npm --prefix examples/universal-app run mobile:sync",
    "prepare": "node scripts/install-git-hooks.mjs",
    "changeset": "changeset",
    "changeset:version": "node scripts/changeset-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:status": "changeset status --since=origin/main"
  },
  "keywords": [
    "vietnam",
    "accommodation",
    "telegram-bot",
    "browser-commander",
    "links-notation"
  ],
  "author": "",
  "license": "Unlicense",
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konard/vietnam-accomodation-search.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@mtcute/node": "^0.32.2",
    "browser-commander": "^0.20.0",
    "command-stream": "0.24.1",
    "grammy": "^1.46.0",
    "links-notation": "^0.20.0",
    "lino-arguments": "0.3.0",
    "playwright": "^1.63.0",
    "use-m": "8.16.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jscpd": "^4.0.5",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "teleproto": "^1.229.0",
    "test-anywhere": "^0.8.48"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write",
      "prettier --check"
    ],
    "*.md": [
      "prettier --write",
      "prettier --check"
    ]
  }
}
